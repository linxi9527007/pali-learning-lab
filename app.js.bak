const VERSION = '2.0 重构稳定版';
let currentPage = 'home';

// 简单缓存与工具
const __cache = new Map();
function $q(sel,root=document){return root.querySelector(sel)}
function $qa(sel,root=document){return [...root.querySelectorAll(sel)]}
function esc(s){return String(s||'').replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#039;"}[ch]))}
async function fetchJson(path){
    if(__cache.has(path)) return __cache.get(path);
    try{const res=await fetch(path); if(!res.ok) throw new Error(path+' load failed'); const data=await res.json(); __cache.set(path,data); return data;}catch(e){console.warn('fetchJson failed',path,e); throw e}
}
async function fetchJsObject(path,nameGuess){
    if(__cache.has(path)) return __cache.get(path);
    try{
        const res=await fetch(path); if(!res.ok) throw new Error(path+' load failed'); const txt=await res.text();
        // 尝试从赋值表达式中提取 JSON-like 内容
        const assignIndex = txt.indexOf('=');
        let payload=null;
        if(assignIndex>0){
            const rhs=txt.slice(assignIndex+1);
            // 尝试查找开头的 [ or { 并截取到末尾的相应配对
            const first = rhs.search(/\S/);
            if(first>=0){
                const open = rhs[first];
                if(open==='['||open==='{'){
                    // 找到匹配闭合的简单方法——找到最后一个相同闭合字符
                    const close = open==='['?']':'}';
                    const last = rhs.lastIndexOf(close);
                    if(last>0){
                        const candidate = rhs.slice(first, last+1);
                        try{payload = (new Function('return ('+candidate+');'))();}catch(e){payload=null}
                    }
                }
            }
        }
        if(payload===null){
            // 退而求其次：尝试从全局变量名猜测
            if(nameGuess){
                try{const obj=(new Function(txt+'; return (typeof '+nameGuess+'!=="undefined")?'+nameGuess+':null;'))(); payload=obj}catch(e){payload=null}
            }
        }
        __cache.set(path,payload);
        return payload;
    }catch(e){console.warn('fetchJsObject failed',path,e); return null}
}

// 保留原来的 DOMContentLoaded 底座，但增强路由绑定和事件代理
window.addEventListener('DOMContentLoaded', () => {
        try {
                const appContainer = document.getElementById('app');
                if (!appContainer) return;
                // 支持 data-view 与 data-page 两种属性的导航按钮
                $qa('[data-view],[data-page]').forEach(btn => btn.addEventListener('click', (e)=>{
                        const view = btn.getAttribute('data-view')||btn.getAttribute('data-page');
                        if(view) showView(view);
                }));
                // 全局事件代理（例如浮动回顶按钮）
                document.body.addEventListener('click',(e)=>{
                        const a = e.target.closest('[data-action]'); if(a){
                                const act = a.dataset.action;
                                if(act==='top') { scrollToTop(); return; }
                                if(act==='term') { showTermPopup(a.dataset.term, a); return; }
                                if(act==='token') { showTokenPopup(a.dataset.term, a); return; }
                                if(act==='close-popup'){ const old=document.getElementById('term-popup'); if(old) old.remove(); return; }
                        }
                });
                showView('home');
                console.log("Pāli Lab 2.0 重构版全自动底座激活成功！");
        } catch (e) { console.error(e); }
});

function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }

function buildZone(title, content){
    return `<div class="zone"><h3>${esc(title)}</h3>${content||'<div class="muted">暂无内容</div>'}</div>`;
}
function renderFiveZonePage(title, sections){
    return `<section class="card five-zone"><h2>${esc(title)}</h2><div class="zone-grid">${buildZone('本节内容', sections.content)}${buildZone('语法分析', sections.analysis)}${buildZone('术语表', sections.terminology)}${buildZone('本节单词', sections.wordlist)}${buildZone('练习交互', sections.exercises)}</div></section>`;
}
function normalizeTokenKey(key){ return String(key||'').trim().toLowerCase().replace(/ṃ/g,'ṃ'); }
function findTokenEntry(word,data){
    if(!word || !data) return null;
    const key = String(word||'').trim();
    if(data[key]) return data[key];
    const norm = normalizeTokenKey(key);
    for(const k of Object.keys(data||{})){
        if(normalizeTokenKey(k)===norm) return data[k];
    }
    return null;
}
async function loadTerminology(filter=''){
    const glossary = (window.TERMINOLOGY_GLOSSARY) || (await fetchJsObject('terminology-glossary-data.js','TERMINOLOGY_GLOSSARY')) || (await fetchJson('terminology-glossary-data.js').catch(()=>[])) || [];
    const tips = (window.LINGUISTICS_TIPS) || (await fetchJsObject('linguistics-tips-data.js','LINGUISTICS_TIPS')) || (await fetchJson('linguistics-tips-data.js').catch(()=>[])) || [];
    const q = String(filter||'').toLowerCase();
    const glossaryHtml = (glossary||[]).filter(item=>!q||JSON.stringify(item).toLowerCase().includes(q)).slice(0,6).map(item=>`<div class="term-item"><button class="term-link" data-action="term" data-term="${esc(item.term||item.q||item.title||'')}">${esc(item.term||item.q||item.title||'')}</button><div class="muted">${esc(item.cn||item.meaning||item.desc||item.summary||'')}</div></div>`).join('');
    const tipHtml = (tips||[]).filter(item=>!q||JSON.stringify(item).toLowerCase().includes(q)).slice(0,4).map(item=>`<div class="term-item"><button class="term-link" data-action="term" data-term="${esc(item.id||item.title||item.tag||'')}">${esc(item.title||item.id||'语言点')}</button><div class="muted">${esc(item.summary||item.desc||item.note||'')}</div></div>`).join('');
    return `<div class="terminology-list">${glossaryHtml}${tipHtml}</div>`;
}
async function buildTokenSection(words=[]){
    const data = (window.TOKEN_ANALYSIS_DATA) || (await fetchJsObject('token-analysis-data.js','TOKEN_ANALYSIS_DATA')) || (await fetchJson('token-analysis-data.js').catch(()=>({}))) || {};
    const keys = Array.isArray(words)?words.slice(0,8):[words];
    const cards = keys.map(w=>{
        if(!w) return '';
        const entry = findTokenEntry(w,data);
        if(!entry) return '';
        const examples = (entry.examples||[]).slice(0,2).map(ex=>`<div class="small-example"><span class="pali">${esc(ex.sentence||'')}</span><span class="muted">${esc(ex.translation||'')}</span></div>`).join('');
        const analysis = (entry.analyses||[]).map(a=>`${esc(a.grammar||'')} · ${esc(a.role||'')} · ${esc(a.meaning||'')}`).join('<br>');
        return `<div class="token-card"><button class="term-link" data-action="token" data-term="${esc(entry.form||w)}">${esc(entry.form||w)}</button><div class="analysis">${analysis}</div>${examples}</div>`;
    }).filter(Boolean).join('');
    if(!cards) return '<div class="muted">暂无逐词分析条目。</div>';
    return `<div class="token-list">${cards}</div>`;
}
function openPopup(title,html,target){
    const old = document.getElementById('term-popup'); if(old) old.remove();
    const popup = document.createElement('div'); popup.id='term-popup'; popup.className='term-popup';
    popup.innerHTML = `<div class="popup-header"><strong>${esc(title)}</strong><button class="close-popup" data-action="close-popup">×</button></div><div class="popup-body">${html}</div>`;
    document.body.appendChild(popup);
    const rect = target.getBoundingClientRect();
    popup.style.position='absolute';
    popup.style.top = `${rect.bottom + window.scrollY + 8}px`;
    popup.style.left = `${rect.left + window.scrollX}px`;
    popup.style.zIndex = 9999;
}
async function showTermPopup(term,target){
    if(!term) return;
    const glossary = (window.TERMINOLOGY_GLOSSARY) || (await fetchJsObject('terminology-glossary-data.js','TERMINOLOGY_GLOSSARY')) || (await fetchJson('terminology-glossary-data.js').catch(()=>[])) || [];
    const tips = (window.LINGUISTICS_TIPS) || (await fetchJsObject('linguistics-tips-data.js','LINGUISTICS_TIPS')) || (await fetchJson('linguistics-tips-data.js').catch(()=>[])) || [];
    let item = glossary.find(i=>String(i.term||i.q||i.title||'').toLowerCase()===String(term||'').toLowerCase());
    let html = '';
    if(item){ html = `<p>${esc(item.cn||item.meaning||item.desc||item.summary||'')}</p>`; if(item.examples) html += `<div class="muted">${esc(JSON.stringify(item.examples).slice(0,120))}</div>`; }
    else { item = tips.find(i=>String(i.id||i.title||'').toLowerCase()===String(term||'').toLowerCase()); if(item){ html=`<p>${esc(item.summary||item.desc||item.note||'')}</p>`; html += `<div class="muted">${esc(item.title||item.id)}</div>`; } }
    if(!html) html = `<div class="muted">未找到术语或语言点 ${esc(term)}</div>`;
    openPopup(term,html,target);
}
async function showTokenPopup(term,target){
    if(!term) return;
    const data = (window.TOKEN_ANALYSIS_DATA) || (await fetchJsObject('token-analysis-data.js','TOKEN_ANALYSIS_DATA')) || (await fetchJson('token-analysis-data.js').catch(()=>({}))) || {};
    const entry = findTokenEntry(term,data);
    let html='';
    if(entry){
        const analysis = (entry.analyses||[]).map(a=>`<div>${esc(a.grammar||'')} · ${esc(a.role||'')} · ${esc(a.meaning||'')}</div>`).join('');
        const examples = (entry.examples||[]).slice(0,3).map(ex=>`<div class="small-example"><span class="pali">${esc(ex.sentence||'')}</span><span class="muted">${esc(ex.translation||'')}</span></div>`).join('');
        html = `<div>${analysis}</div>${examples}`;
    } else html = `<div class="muted">未找到逐词分析：${esc(term)}</div>`;
    openPopup(term,html,target);
}

// 主路由与视图渲染
async function showView(viewId){
    currentPage = viewId;
    const app = $q('#app'); if(!app) return;
    app.innerHTML = '<div class="card loading">正在加载，请稍候……</div>';
    try{
        if(viewId==='home' || viewId===''){
            const grammar = await fetchJson('grammar-index.json').catch(()=>[]);
            const exerciseIndex = await fetchJson('exercise-index.json').catch(()=>[]);
            const lessonCount = grammar.length || 0;
            const exerciseCount = exerciseIndex.length || 0;
            app.innerHTML = `
                <section class="card">
                    <h2>欢迎 — 巴利语语法复习</h2>
                    <p class="muted">Pāli Learning Lab · ${VERSION}</p>
                    <div class="summary">
                        <div>语法点：${lessonCount}</div>
                        <div>练习题：${exerciseCount}</div>
                    </div>
                    <div class="grid">
                        <button data-page="routes" class="primary">零基础路线</button>
                        <button data-page="modules" class="primary">模块学习</button>
                        <button data-page="sentence" class="primary">句子分析</button>
                        <button data-page="buddhist" class="primary">佛典阅读</button>
                        <button data-page="dictionary" class="primary">查词</button>
                        <button data-page="search" class="primary">搜索</button>
                    </div>
                </section>`;
            return;
        }

        if(viewId==='routes' || viewId==='basic'){
            const routes = (await fetchJsObject('learning-routes-data.js','LEARNING_ROUTES')) || (await fetchJson('learning-routes-data.js').catch(()=>null)) || [];
            const grammar = await fetchJson('grammar-index.json').catch(()=>[]);
            const byId = new Map(grammar.map(g=>[String(g.id),g]));
            const first = routes[0]||{title:'路线',steps:[]};
            const routeHtml = routes.map(r=>`<button class="route-tab" data-route="${esc(r.id)}">${esc(r.title)}</button>`).join('');
            const lessonButtons = (first.steps||[]).flatMap(s=> (s.lesson_ids||[]).map(id=>{ const l = byId.get(String(id)); return l?`<button class="lesson-open" data-lesson="${esc(l.id)}">${esc(l.lesson_number||l.id)}. ${esc(l.title)}</button>`:''; })).join('');
            const wordlist = grammar.slice(0,8).map(l=>`<button class="term-link" data-action="term" data-term="${esc(l.title)}">${esc(l.lesson_number||l.id)}. ${esc(l.title)}</button>`).join('');
            app.innerHTML = renderFiveZonePage('零基础路线', {
                content:`<div class="tabs">${routeHtml}</div><div class="route-preview"><p class="muted">当前路线：${esc(first.title||'默认路线')}</p><div class="button-row">${lessonButtons}</div></div>`,
                analysis:`<p>零基础路线将语法点按阶段梳理，先从发音、词形、动词、格位逐步推进。可点击上方课程按钮直接进入具体语法点。</p>${await buildTokenSection((first.steps||[]).flatMap(s=>s.lesson_ids||[]).slice(0,6).map(id=>byId.get(String(id))?.title).filter(Boolean))}`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">${wordlist}</div>`,
                exercises:`<div class="exercise-note">请选择一个课程，查看本节练习与分层题目。</div>`
            });
            app.querySelectorAll('.lesson-open').forEach(b=>b.addEventListener('click',()=> showLesson(b.dataset.lesson)));
            return;
        }

        if(viewId==='modules' || viewId==='module'){
            const grammar = await fetchJson('grammar-index.json').catch(()=>[]);
            const groups={}; grammar.forEach(l=>{(groups[l.module||'其他']||=(groups[l.module||'其他']||[])).push(l)});
            const cards = Object.keys(groups).map(m=>`<div class="module-card" data-module="${esc(m)}"><h3>${esc(m)}</h3><p class="muted">${groups[m].length} 个语法点</p></div>`).join('');
            const moduleList = Object.keys(groups).slice(0,8).map(m=>`<button class="term-link" data-action="term" data-term="${esc(m)}">${esc(m)}</button>`).join('');
            app.innerHTML = renderFiveZonePage('模块学习', {
                content:`<div class="grid">${cards}</div>`,
                analysis:`<p>模块学习按语法类别分组，便于查缺补漏与专题复习。</p>${await buildTokenSection(Object.keys(groups).slice(0,6))}`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">${moduleList}</div>`,
                exercises:`<div class="button-row">${Object.keys(groups).slice(0,10).map(m=>`<button class="module-open" data-module="${esc(m)}">${esc(m)}</button>`).join('')}</div>`
            });
            app.querySelectorAll('.module-open').forEach(b=>b.addEventListener('click',()=> showModuleLessons(b.dataset.module)));
            return;
        }

        if(viewId==='sentence' || viewId==='analysis'){
            const sentences = (await fetchJsObject('sentence-analysis-data.js','SENTENCE_ANALYSIS_DATA')) || (await fetchJson('sentence-analysis-data.js').catch(()=>null)) || [];
            const list = (sentences||[]).slice(0,12).map(s=>`<button class="sentence-open" data-id="${esc(s.id)}">${esc(s.sentence||s.title||'句子')}</button>`).join('');
            const first = sentences[0]||{};
            app.innerHTML = renderFiveZonePage('句子分析', {
                content:`<div class="result-list">${list}</div>`,
                analysis:`<p>句子分析模块提供逐词结构、语法角色与翻译提示。点击任意句子即可加载对应分析。</p>${await buildTokenSection(first.tokens||[])}`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">${(first.tokens||[]).slice(0,10).map(t=>`<button class="term-link" data-action="token" data-term="${esc(t.form||'')}">${esc(t.form||'')}</button>`).join('')}</div>`,
                exercises:`<div class="exercise-note">点击句子后查看本节练习与自检问题。</div>`
            });
            app.querySelectorAll('.sentence-open').forEach(b=>b.addEventListener('click',()=> renderSentence(b.dataset.id)));
            return;
        }

        if(viewId==='buddhist' || viewId==='reading'){
            const reading = (await fetchJsObject('buddhist-reading-data.js','BUDDHIST_READING_PATTERNS')) || (await fetchJson('buddhist-reading-data.js').catch(()=>[])) || [];
            const list = (reading||[]).slice(0,10).map(r=>`<button class="reading-open" data-reading="${esc(r.id)}">${esc(r.title)}</button>`).join('');
            const first = reading[0]||{};
            const keywords = (first.keywords||[]).slice(0,10).map(k=>`<button class="term-link" data-action="term" data-term="${esc(k.word||k)}">${esc(k.word||k)}</button>`).join('');
            app.innerHTML = renderFiveZonePage('佛典阅读', {
                content:`<div class="result-list">${list}</div>`,
                analysis:`<p>佛典阅读模块用于训练巴利文阅读理解与背景知识。可点击条目查看结构与关键词解析。</p><div class="muted">${esc(first.structure||'请选择一条阅读内容')}</div>`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">${keywords}</div>`,
                exercises:`<div class="button-row">${(reading||[]).slice(0,8).map(r=>`<button class="reading-open" data-reading="${esc(r.id)}">${esc(r.title)}</button>`).join('')}</div>`
            });
            app.querySelectorAll('.reading-open').forEach(b=>b.addEventListener('click',()=> showReading(b.dataset.reading)));
            return;
        }

        if(viewId==='dictionary' || viewId==='dict'){
            const dictSites = (await fetchJsObject('dictionary-sites-data.js','PALI_DICTIONARY_SITES')) || (await fetchJson('dictionary-sites-data.js').catch(()=>[])) || [];
            const sitesHtml = dictSites.map(d=>`<div class="dict-site"><a href="${esc(d.url||'#')}" target="_blank">${esc(d.name)}</a><div class="muted">${esc(d.best_for||'')}</div></div>`).join('');
            app.innerHTML = renderFiveZonePage('查词', {
                content:`<div class="search-row"><input id="dict-q" placeholder="输入要查的巴利词或拼写"><button id="dict-search">查本地</button></div><div id="dict-local-results"></div>`,
                analysis:`<p>本地查词优先匹配实时语法与句子分析结果。查询后可点击词语查看逐词分析。</p>`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">${dictSites.slice(0,8).map(d=>`<button class="term-link" data-action="term" data-term="${esc(d.name)}">${esc(d.name)}</button>`).join('')}</div>`,
                exercises:`<div class="muted">输入词条后可直接打开相关句子、课程或阅读条目。</div>`
            });
            const qinput = $q('#dict-q'); $q('#dict-search').addEventListener('click', async ()=>{
                const q = (qinput.value||'').trim().toLowerCase(); if(!q) return; const hits = await localSearch(q); const el = $q('#dict-local-results'); if(!el) return;
                if(!hits.length) el.innerHTML = `<div class="muted">未找到本地匹配。</div>`;
                else el.innerHTML = hits.map(h=>`<div class="hit ${esc(h.type)}"><strong>${esc(h.title)}</strong><div class="muted">${esc(h.snippet||'')}</div><div><button class="dict-open" data-type="${esc(h.type)}" data-id="${esc(h.id)}">打开</button></div></div>`).join('');
                el.querySelectorAll('.dict-open').forEach(b=>b.addEventListener('click',()=>{
                    const t=b.dataset.type, id=b.dataset.id; if(t==='lesson') showLesson(id); if(t==='sentence') renderSentence(id); if(t==='reading') showReading(id);
                }));
            });
            return;
        }

        if(viewId==='search'){
            app.innerHTML = renderFiveZonePage('搜索', {
                content:`<div class="search-row"><input id="pll-search" placeholder="输入关键词"><button id="pll-search-go">搜索</button></div><div id="pll-search-results"></div>`,
                analysis:`<p>搜索会在语法、句子、阅读、术语和提示中查找相关内容。</p><div class="muted">搜索结果将在下方展示。</div>`,
                terminology:await loadTerminology(),
                wordlist:`<div class="wordlist-preview">常见搜索词：<button class="term-link" data-action="term" data-term="语法">语法</button><button class="term-link" data-action="term" data-term="句子">句子</button><button class="term-link" data-action="term" data-term="阅读">阅读</button></div>`,
                exercises:`<div class="muted">输入关键词后，点击打开结果进入对应页面。</div>`
            });
            const input = $q('#pll-search'); $q('#pll-search-go').addEventListener('click', async ()=>{
                const q = (input.value||'').trim().toLowerCase(); if(!q) return $q('#pll-search-results').innerHTML='';
                const hits = await localSearch(q, {limit:200});
                $q('#pll-search-results').innerHTML = hits.map(h=>`<div class="search-hit ${esc(h.type)}"><strong>${esc(h.title)}</strong><div class="muted">${esc(h.snippet||'')}</div><div><button class="search-open" data-go="${esc(h.type)}" data-id="${esc(h.id)}">打开</button></div></div>`).join('') || '<div class="muted">未找到结果。</div>';
                $q('#pll-search-results').querySelectorAll('.search-open').forEach(b=>b.addEventListener('click',()=>{
                    const t=b.dataset.go, id=b.dataset.id; if(t==='lesson') showLesson(id); if(t==='sentence') renderSentence(id); if(t==='reading') showReading(id); if(t==='tip') showTermPopup(id,b);
                }));
            });
            return;
        }

        // fallback
        app.innerHTML = `<section class="card"><h2>未识别视图：${esc(viewId)}</h2></section>`;
    }catch(e){
        app.innerHTML = `<div class="error">渲染出错：${esc(e.message||e)}</div>`; console.error(e);
    }
}

// 辅助渲染函数
async function showLesson(id){
    const app = $q('#app'); if(!app) return;
    // load base index to show title if needed
    const grammar = await fetchJson('grammar-index.json').catch(()=>[]);
    const idxItem = grammar.find(g=>String(g.id)===String(id)) || {};
    // load manifest to locate detailed chunk
    const manifest = await fetchJson('grammar-lesson-manifest.json').catch(()=>null);
    let detail = null;
    if(manifest && String(manifest[String(id)]||manifest[id])){
        const chunkFile = manifest[String(id)] || manifest[id];
        if(chunkFile) detail = (await fetchJson(chunkFile).catch(()=>null))?.find(l=>String(l.id)===String(id)) || null;
    }
    // fallback: if not found in chunk, try to use index item fields
    const lesson = detail || idxItem;
    // render full lesson content
    let html = `<section class="card lesson-detail"><h2>${esc(lesson.title||idxItem.title||('语法点 '+id))}</h2>`;
    if(lesson.summary) html += `<p class="muted">${esc(lesson.summary)}</p>`;
    if(lesson.explanation && Array.isArray(lesson.explanation)){
        html += '<div class="explanation">'+lesson.explanation.map(p=>`<p>${esc(p)}</p>`).join('')+'</div>';
    }
    if(lesson.table && Array.isArray(lesson.table)){
        html += '<table class="form-table">'+lesson.table.map((row,i)=>'<tr>'+row.map(c=>`<td>${esc(c)}</td>`).join('')+'</tr>').join('')+'</table>';
    }
    if(lesson.examples && Array.isArray(lesson.examples) && lesson.examples.length){
        html += '<h3>例句与对照</h3><div class="examples">'+lesson.examples.map(ex=>`<div class="example"><div class="pali">${esc(ex.pali||'')}</div><div class="cn">${esc(ex.cn||'')}</div><div class="note muted">${esc(ex.note||'')}</div></div>`).join('')+'</div>';
    }
    if(lesson.cards && Array.isArray(lesson.cards) && lesson.cards.length){
        html += '<h3>自测卡片</h3><div class="cards">'+lesson.cards.map((c,idx)=>`<div class="card-qa"><div class="q">Q${idx+1}: ${esc(c.q)}</div><button class="show-a" data-qa="${idx}">显示答案</button><div class="a" data-qa="${idx}" style="display:none;">${esc(c.a)}</div></div>`).join('')+'</div>';
    }
    // exercises (layered_exercises)
    if(lesson.layered_exercises && Array.isArray(lesson.layered_exercises) && lesson.layered_exercises.length){
        html += '<h3>练习</h3>';
        lesson.layered_exercises.forEach(layer=>{
            html += `<div class="exercise-layer"><h4>${esc(layer.title||layer.key||'练习')}</h4>`;
            if(Array.isArray(layer.items)){
                html += '<ol class="exercise-list">';
                layer.items.forEach((it,i)=>{
                    const options = (it.options||[]).map(opt=>`<button class="opt" data-answer="${esc(it.answer)}">${esc(opt)}</button>`).join('');
                    html += `<li class="exercise-item" data-id="${esc(it.id||i)}"><div class="q">${esc(it.question||'')}</div><div class="opts">${options}</div><div class="hint muted" style="display:none;">${esc(it.explanation||it.feedback_hint||'')}</div></li>`;
                });
                html += '</ol>';
            }
            html += '</div>';
        });
    }
    html += '</section>';
    app.innerHTML = html;
    // bind interactions: show answer for cards
    app.querySelectorAll('button.show-a').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.qa; const a=$q('.a[data-qa="'+id+'"]'); if(a) a.style.display=a.style.display==='none'?'block':'none';}));
    // bind exercise options
    app.querySelectorAll('.exercise-item .opt').forEach(btn=>btn.addEventListener('click',(e)=>{
        const btnEl=e.currentTarget; const parent=btnEl.closest('.exercise-item'); if(!parent) return;
        const correct = btnEl.getAttribute('data-answer');
        const chosen = btnEl.textContent;
        const hint = parent.querySelector('.hint');
        if(hint) hint.style.display = 'block';
        // simple visual feedback
        parent.querySelectorAll('.opt').forEach(o=>o.disabled=true);
        if(chosen===correct){ btnEl.style.backgroundColor='#c8f7c5'; } else { btnEl.style.backgroundColor='#ffd6d6'; const right = Array.from(parent.querySelectorAll('.opt')).find(o=>o.getAttribute('data-answer')===o.textContent); if(right) right.style.outline='2px solid #2b7'; }
    }));
}
async function showModuleLessons(module){
    const grammar = await fetchJson('grammar-index.json').catch(()=>[]);
    const lessons = grammar.filter(l=>l.module===module);
    const app = $q('#app'); if(!app) return;
    const listHtml = lessons.map(l=>`<div class="lesson-card" data-lesson="${esc(l.id)}"><h3>${esc(l.lesson_number||l.id)}. ${esc(l.title)}</h3><p class="muted">${esc(l.summary||'')}</p><div class="meta">练习题：${esc(l.exercise_count||0)} · 卡片：${esc(l.card_count||0)}</div></div>`).join('');
    app.innerHTML = `<section class="card"><h2>${esc(module)}</h2><div class="result-list">${listHtml}</div></section>`;
    app.querySelectorAll('.lesson-card').forEach(c=>c.addEventListener('click',()=>showLesson(c.dataset.lesson)));
}
async function renderSentence(id){
    const app = $q('#app'); if(!app) return;
    const sentences = (window.SENTENCE_ANALYSIS_DATA) || (await fetchJsObject('sentence-analysis-data.js','SENTENCE_ANALYSIS_DATA')) || (await fetchJson('sentence-analysis-data.js').catch(()=>[])) || [];
    const s = sentences.find(x=>String(x.id)===String(id)) || sentences[Number(id)] || null;
    if(!s){ app.innerHTML = `<section class="card"><h2>句子 ${esc(id)}</h2><div class="muted">未找到句子分析条目。</div></section>`; return; }
    let html = `<section class="card sentence-detail"><h2>${esc(s.sentence||s.title||('句子 '+id))}</h2>`;
    if(s.translation) html += `<p class="muted">译：${esc(s.translation)}</p>`;
    if(s.structure) html += `<p><strong>结构：</strong>${esc(s.structure)}</p>`;
    if(Array.isArray(s.tokens) && s.tokens.length){
        html += '<h3>分词分析</h3><ol class="tokens">'+s.tokens.map(t=>`<li><div class="form">${esc(t.form||'')}</div><div class="meta">${esc(t.grammar||'')}</div><div class="role muted">${esc(t.role||'')}</div><div class="meaning">${esc(t.meaning||'')}</div></li>`).join('')+'</ol>';
    }
    if(s.tip) html += `<div class="tip"><strong>提示：</strong>${esc(s.tip)}</div>`;
    if(Array.isArray(s.self_check) && s.self_check.length){ html += '<h3>自检题</h3><ul class="self-check">'+s.self_check.map(q=>`<li>${esc(q)}</li>`).join('')+'</ul>'; }
    // navigation: prev/next by recommended_order or index
    const idx = sentences.findIndex(x=>String(x.id)===String(id));
    html += '<div class="nav-row">';
    if(idx>0) html += `<button class="btn" data-prev="${esc(sentences[idx-1].id)}">← 上一条</button>`;
    if(idx<sentences.length-1) html += `<button class="btn" data-next="${esc(sentences[idx+1].id)}">下一条 →</button>`;
    html += '</div>';
    html += '</section>';
    app.innerHTML = html;
    // bind nav
    app.querySelectorAll('.nav-row button').forEach(b=>b.addEventListener('click',()=>{
        const prev=b.dataset.prev||b.dataset.next; if(prev) renderSentence(prev);
    }));
}
// show reading detail
async function showReading(id){
    const app = $q('#app'); if(!app) return;
    const data = (window.BUDDHIST_READING_PATTERNS) || (await fetchJsObject('buddhist-reading-data.js','BUDDHIST_READING_PATTERNS')) || (await fetchJson('buddhist-reading-data.js').catch(()=>[])) || [];
    const item = data.find(x=>String(x.id)===String(id)) || null;
    if(!item){ app.innerHTML = `<section class="card"><h2>阅读 ${esc(id)}</h2><div class="muted">未找到条目</div></section>`; return; }
    let html = `<section class="card reading-detail"><h2>${esc(item.title)}</h2>`;
    if(item.literal) html += `<p class="muted">${esc(item.literal)}</p>`;
    if(item.formula) html += `<p><strong>公式：</strong>${esc(item.formula)}</p>`;
    if(item.natural) html += `<div class="natural">${esc(item.natural)}</div>`;
    if(Array.isArray(item.keywords) && item.keywords.length) html += '<h3>关键词</h3><ul>'+item.keywords.map(k=>`<li><strong>${esc(k.word||k)}</strong> ${esc(k.note||'')}</li>`).join('')+'</ul>';
    if(item.structure) html += `<p><strong>要点：</strong>${esc(item.structure)}</p>`;
    if(item.warning) html += `<div class="warning">${esc(item.warning)}</div>`;
    html += '</section>';
    app.innerHTML = html;
}

// localSearch across grammar, sentences, readings, tips and module guides
async function localSearch(q, opts={limit:100}){
    q = String(q||'').toLowerCase(); const limit = opts.limit||100;
    const [grammar, sentences, reading, tips, modules] = await Promise.all([
        fetchJson('grammar-index.json').catch(()=>[]),
        fetchJsObject('sentence-analysis-data.js','SENTENCE_ANALYSIS_DATA').catch(()=>[]),
        fetchJsObject('buddhist-reading-data.js','BUDDHIST_READING_PATTERNS').catch(()=>[]),
        fetchJsObject('linguistics-tips-data.js','LINGUISTICS_TIPS').catch(()=>[]),
        fetchJsObject('module-guides-data.js','MODULE_GUIDES').catch(()=>[])
    ]).catch(()=>[[],[],[],[],[]]);
    const hits = [];
    // grammar
    (grammar||[]).forEach(g=>{ const text = JSON.stringify(g).toLowerCase(); if(text.includes(q)) hits.push({type:'lesson',id:g.id,title:g.title||('语法 '+g.id),snippet:g.summary||g.module||''}) });
    // sentences
    (sentences||[]).forEach(s=>{ const text = JSON.stringify(s).toLowerCase(); if(text.includes(q)) hits.push({type:'sentence',id:s.id,title:s.sentence||s.id,snippet:s.translation||s.structure||''}) });
    // reading
    (reading||[]).forEach(r=>{ const text = JSON.stringify(r).toLowerCase(); if(text.includes(q)) hits.push({type:'reading',id:r.id,title:r.title||r.id,snippet:r.literal||r.natural||''}) });
    // tips
    (tips||[]).forEach(t=>{ const text = JSON.stringify(t).toLowerCase(); if(text.includes(q)) hits.push({type:'tip',id:t.id,title:t.title||t.id,snippet:t.summary||''}) });
    // modules
    (modules||[]).forEach(m=>{ const text = JSON.stringify(m).toLowerCase(); if(text.includes(q)) hits.push({type:'module',id:m.module||m.title,title:m.title||m.module,snippet:m.goal||''}) });
    // dedupe by type+id
    const seen=new Set(); const ded = []; for(const h of hits){ const key = `${h.type}::${h.id}`; if(seen.has(key)) continue; seen.add(key); ded.push(h); if(ded.length>=limit) break }
    return ded;
}

// 导出全局以便页面其它脚本可以调用
window.showView = showView;
window.scrollToTop = scrollToTop;
